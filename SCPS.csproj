<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>SCPS</AssemblyName>
    <RootNamespace>SCPS</RootNamespace>
    <AssemblyTitle>SCPS</AssemblyTitle>
    <Description>[SCP와 재단] 게임 플러그인</Description>
    <Company>Golden Game (gg)</Company>
    <Product>SCPS</Product>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <EXILED_REFERENCES Condition="'$(EXILED_REFERENCES)' == ''">$(MSBuildProjectDirectory)\..\..\EXILED_REFERENCES</EXILED_REFERENCES>
    <ExiledPluginsDirectory Condition="'$(ExiledPluginsDirectory)' == '' and '$(APPDATA)' != ''">$(APPDATA)\EXILED\Plugins</ExiledPluginsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExMod.Exiled" Version="9.14.2" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GG\GG\GG.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp-Publicized">
      <HintPath>$(EXILED_REFERENCES)\Assembly-CSharp-Publicized.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(EXILED_REFERENCES)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="AudioPlayerApi">
      <HintPath>$(EXILED_REFERENCES)\AudioPlayerApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommandSystem.Core">
      <HintPath>$(EXILED_REFERENCES)\CommandSystem.Core.dll</HintPath>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(EXILED_REFERENCES)\Mirror.dll</HintPath>
    </Reference>
    <Reference Include="MultiBroadcast">
      <HintPath>$(EXILED_REFERENCES)\MultiBroadcast.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NorthwoodLib">
      <HintPath>$(EXILED_REFERENCES)\NorthwoodLib.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(EXILED_REFERENCES)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Pooling">
      <HintPath>$(EXILED_REFERENCES)\Pooling.dll</HintPath>
    </Reference>
    <Reference Include="ProjectMER">
      <HintPath>$(EXILED_REFERENCES)\ProjectMER.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(EXILED_REFERENCES)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(EXILED_REFERENCES)\UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(EXILED_REFERENCES)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(EXILED_REFERENCES)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToExiledPlugins"
          AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' and '$(ExiledPluginsDirectory)' != ''">
    <MakeDir Directories="$(ExiledPluginsDirectory)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ExiledPluginsDirectory)"
          SkipUnchangedFiles="true" />
    <Message Importance="high"
             Text="Deployed $(TargetFileName) to shared EXILED Plugins directory: $(ExiledPluginsDirectory)" />
  </Target>

</Project>
